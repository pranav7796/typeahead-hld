# Host port overrides — 5432 and 3000 are used by other local projects.
POSTGRES_HOST_PORT=5433
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8080

# Docker Desktop on this system runs Linux containers on amd64.
DOCKER_PLATFORM=linux/amd64

# Local DB credentials used by postgres, backend and dataset loader.
POSTGRES_DB=typeahead
POSTGRES_USER=typeahead
POSTGRES_PASSWORD=typeahead

# Loader sizing (top N ORCAS queries to import).
ORCAS_TOP_N=1000000
